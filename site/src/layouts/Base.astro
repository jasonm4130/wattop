---
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/site.css';

interface Props {
  title: string;
  description: string;
  path?: string;
  noindex?: boolean;
}
const { title, description, path = '/', noindex = false } = Astro.props;
const canonical = new URL(path, 'https://wattop.app').href;
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline src="/theme-init.js"></script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#0d1117" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/jetbrains-mono-wght.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="wattop" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content="https://wattop.app/og.png" />
    <meta property="og:image:width" content="1280" />
    <meta property="og:image:height" content="640" />
    <meta property="og:image:alt" content="wattop: agents and Apple Silicon hardware in one terminal pane" />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline defer src="https://app.skopia.dev/skopia.js" data-site="wattop" data-endpoint="https://app.skopia.dev/e"></script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <slot />
  </body>
</html>
